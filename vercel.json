{
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://maxburlak.sanity.studio",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://maxburlak.sanity.studio/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|max-burlak-resume\\.pdf|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.ico|favicon\\.svg|favicon-96x96\\.png|apple-touch-icon\\.png|og-image\\.jpg|site\\.webmanifest|web-app-manifest-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|svg|ico|woff2?))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
