# Site (Vite) — project: https://www.sanity.io/manage/project/1r0eu2jx
# Create a Viewer token at sanity.io/manage → API → Tokens.
# Read at BUILD time only (scripts/fetch-cms.mjs) — never exposed to the browser.
VITE_SANITY_PROJECT_ID=1r0eu2jx
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=

# PostHog (public browser configuration)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sanity Studio (local + deploy: https://maxburlak.sanity.studio)
SANITY_STUDIO_PROJECT_ID=1r0eu2jx
SANITY_STUDIO_DATASET=production
